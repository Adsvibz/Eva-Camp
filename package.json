{
  "name": "eva-camp",
  "version": "0.2.0",
  "private": true,
  "description": "Offline guest and booking management for Eva Camp",
  "main": "out/main/main.cjs",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "dist:win": "npm run build && electron-builder --win nsis --x64 --publish never",
    "test:e2e": "node tests/electron.e2e.cjs"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.54.2",
    "zod": "4.6.7",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^1.0.1",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "electron": "45.3.0",
    "electron-builder": "26.18.0",
    "electron-vite": "^3.0.0",
    "playwright": "1.56.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "5.1.0"
  },
  "build": {
    "appId": "com.evacamp.desktop",
    "productName": "Eva Camp",
    "files": [
      "out/**/*",
      "db/migrations/**/*",
      "assets/**/*"
    ],
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "evacamp.exe"
    }
  }
}
